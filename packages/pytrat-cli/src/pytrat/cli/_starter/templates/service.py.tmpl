"""orders-service: creates an order only if a Transaction Token authorized exactly that order.

Run it:  uvicorn service:app --factory --port 8000
"""

from pathlib import Path
from typing import Annotated

from fastapi import Depends, FastAPI
from pydantic import BaseModel, ConfigDict, Field

from pytrat.core import (
    KeyProvider,
    StaticKeySet,
    TokenVerifier,
    VerifierSettings,
    WorkloadJwtAuthenticator,
    WorkloadKeys,
)
from pytrat.fastapi import PyTraT, Transaction

TRUST_DOMAIN = "__TRUST_DOMAIN__"
SERVICE = "orders-service"
KEYS = Path(__file__).parent / "keys"


class Order(BaseModel):
    # strict: "3" is not 3. Bound fields are compared with exact types.
    model_config = ConfigDict(strict=True, extra="forbid")

    customer_id: str = Field(min_length=1)
    sku: str = Field(min_length=1)
    quantity: int = Field(gt=0)


def create_app(tts_keys: KeyProvider, workload_keys: WorkloadKeys) -> FastAPI:
    """Build the service with the keys it trusts (injected, so tests can supply their own)."""
    pytrat = PyTraT(
        service=SERVICE,
        # Only tokens signed by the TTS's keys, for this Trust Domain, are accepted.
        verifier=TokenVerifier(VerifierSettings(trust_domain=TRUST_DOMAIN), tts_keys),
        # Who is calling is proven separately, by a signed workload JWT.
        authenticator=WorkloadJwtAuthenticator(workload_keys, audience=SERVICE),
        # Any route under /internal without a PyTraT requirement is denied, not left open.
        protected_prefixes=("/internal",),
    )
    app = FastAPI(title=SERVICE, lifespan=pytrat.lifespan)
    pytrat.install(app)

    authorized = pytrat.require_transaction(
        scope="orders.create",
        bind_fields=["customer_id", "sku", "quantity"],  # must equal the token's tctx
        allowed_callers=["gateway"],
    )

    @app.post("/internal/orders", status_code=201)
    async def create_order(
        order: Order, txn: Annotated[Transaction, Depends(authorized)]
    ) -> dict[str, object]:
        # Only reached when the token is valid, the caller is the gateway, and the body matches
        # what the user authorized, field for field.
        return {"status": "created", "order": order.model_dump(), "txn": txn.id, "user": txn.subject}

    @app.get("/health")  # outside /internal, so no transaction is required
    async def health() -> dict[str, str]:
        return {"status": "ok"}

    return app


def app() -> FastAPI:
    """The service as uvicorn runs it, trusting the keys generated by `pytrat init`."""
    return create_app(
        StaticKeySet.from_jwks_file(KEYS / "tts.jwks.json"),
        WorkloadKeys({"gateway": StaticKeySet.from_jwks_file(KEYS / "gateway.jwks.json")}),
    )
